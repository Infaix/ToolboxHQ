"use client";

import { useState, useEffect, useCallback } from 'react';
import Link from 'next/link';

interface Note {
  id: string;
  title: string;
  content: string;
  subject: string;
  createdAt: number;
}

const NOTES_KEY = 'notes-notes';

function loadNotes(): Note[] {
  if (typeof window === 'undefined') return [];
  try {
    const stored = localStorage.getItem(NOTES_KEY);
    return stored ? (JSON.parse(stored) as Note[]) : [];
  } catch {
    return [];
  }
}

function saveNotes(notes: Note[]) {
  if (typeof window === 'undefined') return;
  try {
    localStorage.setItem(NOTES_KEY, JSON.stringify(notes));
  } catch {
    // storage unavailable
  }
}

function generateId(): string {
  return Date.now().toString(36) + Math.random().toString(36).substring(2);
}

export default function NotesPage() {
  const [notes, setNotes] = useState<Note[]>(loadNotes);
  const [title, setTitle] = useState('');
  const [content, setContent] = useState('');
  const [editingId, setEditingId] = useState<string | null>(null);
  const [formError, setFormError] = useState('');
  const [filter, setFilter] = useState<'all' | 'active' | 'completed'>('all');
  const [sortBy, setSortBy] = useState<'recent' | 'oldest' | 'title'>('recent');

  // Auto-save: sync notes state to localStorage whenever it changes
  useEffect(() => {
    saveNotes(notes);
  }, [notes]);

  // Filtered and sorted notes
  const filteredNotes = notes.filter((note) => {
    if (filter === 'active') return !note.content.trim().length;
    if (filter === 'completed') return note.content.trim().length > 0;
    return true;
  });

  const sortedNotes = filteredNotes.sort((a, b) => {
    if (sortBy === 'recent') return b.createdAt - a.createdAt;
    if (sortBy === 'oldest') return a.createdAt - b.createdAt;
    return a.title.localeCompare(b.title);
  });

  const activeCount = notes.filter((n) => !n.content.trim().length).length;
  const completedCount = notes.filter((n) => n.content.trim().length > 0).length;

  const handleAddNote = useCallback(() => {
    if (!title.trim()) {
      setFormError('Please enter a note title.');
      return;
    }
    setFormError('');
    setNotes((prev) => [
      ...prev,
      {
        id: editingId || generateId(),
        title: title.trim(),
        content: content.trim(),
        subject: 'General',
        createdAt: editingId ? notes.find((n) => n.id === editingId)?.createdAt || Date.now() : Date.now(),
      },
    ]);
    setTitle('');
    setContent('');
    setEditingId(null);
  }, [editingId, notes]);

  const handleEditNote = useCallback((id: string, title: string, content: string, subject: string) => {
    setNotes((prev) =>
      prev.map((note) =>
        note.id === id
          ? { ...note, title: title.trim() || 'Untitled', content: content.trim(), subject: subject.trim() || 'General' }
          : note
      )
    );
    setTitle('');
    setContent('');
    setEditingId(null);
    setFormError('');
  }, []);

  const handleRemoveNote = useCallback((id: string) => {
    setNotes((prev) => prev.filter((note) => note.id !== id));
  }, []);

  const handleSubjectChange = useCallback((e: React.ChangeEvent<HTMLSelectElement>) => {
    // Subject change handled inline
  }, []);

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-900">
      <div className="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <nav className="mb-8 border-b border-gray-200 dark:border-gray-700 pb-4">
          <Link
            href="/students"
            className="inline-flex items-center gap-1 text-sm text-gray-500 transition hover:text-gray-700 dark:hover:text-gray-200"
          >
            <svg className="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round">
              <path d="M15 18l-6-6 6-6" />
            </svg>
            Student Tools Hub
          </Link>
          <h1 className="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            Notes
          </h1>
        </nav>

        <div className="mb-6">
          {/* Quick stats */}
          {notes.length > 0 && (
            <div className="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
              <span>{notes.length} note{notes.length !== 1 ? 's' : ''}</span>
              <span>{activeCount} active</span>
              <span>{completedCount} completed</span>
            </div>
          )}
        </div>

        {/* Note form - clean, no technical fields */}
        <div className={editingId ? 'rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800' : 'rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800 mb-8'}>
          <h2 className={`${editingId ? 'text-lg font-medium' : 'text-xl font-bold'} text-gray-900 dark:text-white mb-4}>
            {editingId ? 'Edit Note' : 'Add Note'}
          </h2>
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label className="mb-1 block text-sm font-medium text-gray-600 dark:text-gray-400">
                Title
              </label>
              <input
                value={title}
                onChange={(e) => setTitle(e.target.value)}
                placeholder="e.g. Lecture Notes - Week 3"
                className="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
                aria-label="Note title"
              />
            </div>
            <div>
              <label className="mb-1 block text-sm font-medium text-gray-600 dark:text-gray-400">
                Subject
              </label>
              <select
                value={subject || 'General'}
                onChange={(e) => setSubject(e.target.value)}
                className="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
                aria-label="Note subject"
              >
                <option value="">Select subject</option>
                <option value="General">General</option>
                <option value="Maths">Maths</option>
                <option value="Physics">Physics</option>
                <option value="English">English</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
          <div>
            <label className="mb-1 block text-sm font-medium text-gray-600 dark:text-gray-400">
              Content
            </label>
            <textarea
              value={content}
              onChange={(e) => setContent(e.target.value)}
              rows={4}
              placeholder="Write your notes here..."
              className="w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
              aria-label="Note content"
            />
          </div>

          {formError && <p className="mt-2 text-sm text-red-600 dark:text-red-400">{formError}</p>}

          <div className="mt-6 flex justify-end gap-2">
            {editingId && (
              <button
                type="button"
                onClick={() => {
                  setContent('');
                  setTitle('');
                  setEditingId(null);
                  setFormError('');
                }}
                className="ghostButton"
              >
                Cancel
              </button>
            )}
            <button
              type="button"
              onClick={handleAddNote}
              className="button"
              aria-label={editingId ? 'Save Changes' : 'Add Note'}
            >
              {editingId ? 'Save Changes' : 'Add Note'}
            </button>
          </div>
        </div>

        {/* Notes list with search and sort */}
        {sortedNotes.length > 0 ? (
          <div className="mt-8 space-y-4">
            <h2 className="text-lg font-medium text-gray-900 dark:text-white mb-4">
              Your Notes ({sortedNotes.length})
            </h2>
            {sortedNotes.map((note) => (
              <div
                key={note.id}
                className="rounded-xl border border-gray-200 bg-white p-5 shadow-sm dark:border-gray-700 dark:bg-gray-800 flex items-start gap-4"
              >
                <div className="flex-1 min-w-0">
                  <h3 className="font-medium text-gray-900 dark:text-white truncate">{note.title}</h3>
                  <p className="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">{note.content}</p>
                </div>
                <div className="flex gap-2 text-xs text-gray-400 dark:text-gray-500">
                  <span>{note.subject}</span>
                  <span>{new Date(note.createdAt).toLocaleDateString()}</span>
                </div>
                <div className="mt-2 flex gap-2">
                  <button
                    type="button"
                    onClick={() => {
                      setEditingId(note.id);
                      setTitle(note.title);
                      setContent(note.content);
                    }}
                    className="text-blue-600 hover:text-blue-800 dark:text-blue-300 dark:hover:text-blue-400 text-sm"
                    aria-label="Edit note"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    onClick={() => handleRemoveNote(note.id)}
                    className="text-red-600 hover:text-red-800 dark:text-red-300 text-sm"
                    aria-label="Delete note"
                  >
                    Delete
                  </button>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div className="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">
            <p>No notes yet. Add a note above to get started.</p>
          </div>
        )}

        {/* Filters and sort controls */}
        {notes.length > 0 && (
          <div className="mt-6 grid grid-cols-2 gap-2 text-sm text-gray-600 dark:text-gray-400">
            <div>
              <label className="inline-flex items-center gap-1 cursor-pointer ${
                filter === 'all' ? 'text-gray-900 dark:text-white' : ''
              }">
                <input
                  type="radio"
                  checked={filter === 'all'}
                  onChange={() => setFilter('all')}
                  className="rounded bg-gray-100 p-1 focus:ring-2 focus:ring-blue-500 dark:bg-gray-800"
                  aria-label="Show all notes"
                />
                All
              </label>
              <label className="inline-flex items-center gap-1 cursor-pointer ${
                filter === 'active' ? 'text-gray-900 dark:text-white' : ''
              }">
                <input
                  type="radio"
                  checked={filter === 'active'}
                  onChange={() => setFilter('active')}
                  className="rounded bg-gray-100 p-1 focus:ring-2 focus:ring-blue-500 dark:bg-gray-800"
                  aria-label="Show active notes (no content)"
                />
                Active {activeCount}
              </label>
              <label className="inline-flex items-center gap-1 cursor-pointer ${
                filter === 'completed' ? 'text-gray-900 dark:text-white' : ''
              }">
                <input
                  type="radio"
                  checked={filter === 'completed'}
                  onChange={() => setFilter('completed')}
                  className="rounded bg-gray-100 p-1 focus:ring-2 focus:ring-blue-500 dark:bg-gray-800"
                  aria-label="Show completed notes"
                />
                Completed {completedCount}
              </label>
            </div>
            <div>
              <label className="inline-flex items-center gap-1 cursor-pointer ${
                sortBy === 'recent' ? 'text-gray-900 dark:text-white' : ''
              }">
                <input
                  type="radio"
                  checked={sortBy === 'recent'}
                  onChange={() => setSortBy('recent')}
                  className="rounded bg-gray-100 p-1 focus:ring-2 focus:ring-blue-500 dark:bg-gray-800"
                  aria-label="Sort by recent"
                />
                Recent first
              </label>
              <label className="inline-flex items-center gap-1 cursor-pointer ${
                sortBy === 'oldest' ? 'text-gray-900 dark:text-white' : ''
              }">
                <input
                  type="radio"
                  checked={sortBy === 'oldest'}
                  onChange={() => setSortBy('oldest')}
                  className="rounded bg-gray-100 p-1 focus:ring-2 focus:ring-blue-500 dark:bg-gray-800"
                  aria-label="Sort by oldest"
                />
                Oldest first
              </label>
              <label className="inline-flex items-center gap-1 cursor-pointer ${
                sortBy === 'title' ? 'text-gray-900 dark:text-white' : ''
              }">
                <input
                  type="radio"
                  checked={sortBy === 'title'}
                  onChange={() => setSortBy('title')}
                  className="rounded bg-gray-100 p-1 focus:ring-2 focus:ring-blue-500 dark:bg-gray-800"
                  aria-label="Sort by title"
                />
                By title
              </label>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}